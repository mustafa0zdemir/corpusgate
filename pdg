#!/bin/sh
set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$project_root"

command_name=${1:-help}
case "$command_name" in
    init)
        shift
        exec ./scripts/setup.sh "$@"
        ;;
    up)
        shift
        if [ "${1:-}" = "--semantic" ]; then
            shift
            [ "$#" -eq 0 ] || { echo "Usage: ./pdg up [--semantic]" >&2; exit 2; }
            docker compose -f compose.yaml -f compose.semantic.yaml build gateway model-downloader
            docker compose -f compose.yaml -f compose.semantic.yaml \
                --profile semantic-setup run --rm model-downloader
            exec docker compose -f compose.yaml -f compose.semantic.yaml up -d
        fi
        [ "$#" -eq 0 ] || { echo "Usage: ./pdg up [--semantic]" >&2; exit 2; }
        exec docker compose up -d --build
        ;;
    down)
        shift
        [ "$#" -eq 0 ] || { echo "Usage: ./pdg down" >&2; exit 2; }
        exec docker compose -f compose.yaml -f compose.semantic.yaml down
        ;;
    logs)
        shift
        exec docker compose logs "$@" gateway
        ;;
    version)
        shift
        exec docker compose run --rm --no-deps gateway private-document-gateway-admin version "$@"
        ;;
    status|doctor|mcp-smoke|scan|reindex|list-documents|backup)
        shift
        exec docker compose exec -T gateway private-document-gateway-admin "$command_name" "$@"
        ;;
    restore)
        shift
        if docker compose ps --status running --services | grep -qx gateway; then
            echo "Stop the gateway with './pdg down' before restore." >&2
            exit 1
        fi
        exec docker compose run --rm --no-deps gateway \
            private-document-gateway-admin restore "$@"
        ;;
    help|-h|--help)
        cat <<'EOF'
Private Document Gateway operations

  ./pdg init [--semantic]       Prepare a safe local configuration
  ./pdg up [--semantic]         Start lexical or local semantic retrieval
  ./pdg status                  Check the running service
  ./pdg doctor                  Validate configuration and persistent storage
  ./pdg mcp-smoke               Authenticate, list tools, and call list_documents
  ./pdg scan                    Import supported files from ./documents
  ./pdg list-documents          List indexed document metadata
  ./pdg reindex [--semantic]    Rebuild cache/index data
  ./pdg backup                  Create a portable backup
  ./pdg restore FILE --confirm-restore
  ./pdg logs [OPTIONS]          Show gateway logs
  ./pdg down                    Stop the stack
EOF
        ;;
    *)
        echo "Unknown command: $command_name. Run ./pdg help." >&2
        exit 2
        ;;
esac
