# Generate a strong value with: openssl rand -hex 32
PDG_API_KEY=replace-with-at-least-24-random-characters
# Comma-separated current and previous Bearer tokens enable zero-downtime rotation.
PDG_MCP_AUTH_TOKENS=replace-with-a-different-24-character-token
# Production Compose uses this instead: /run/secrets/mcp_auth_token
# PDG_MCP_AUTH_TOKEN_FILE=/run/secrets/mcp_auth_token

PDG_PORT=8000
PDG_MAX_FILE_SIZE_MB=25
PDG_MAX_ARCHIVE_UNCOMPRESSED_MB=250
PDG_CHUNK_SIZE_TOKENS=500
PDG_CHUNK_OVERLAP_TOKENS=50
PDG_MIN_CHUNK_TOKENS=40
PDG_DEFAULT_RESPONSE_MAX_CHARS=8000
PDG_MAX_RESPONSE_CHARS=24000
PDG_DEFAULT_RESPONSE_MAX_TOKENS=2000
PDG_MAX_RESPONSE_TOKENS=6000
PDG_MAX_NEIGHBOR_WINDOW=1
PDG_RATE_LIMIT_REQUESTS=120
PDG_RATE_LIMIT_WINDOW_SECONDS=60
PDG_LOG_LEVEL=INFO
# Required only for public HTTPS deployments.
PDG_PUBLIC_BASE_URL=

# Comma-separated, exact MCP Host-header patterns. Add your DNS name or Tailscale IP.
PDG_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*

# Empty means cross-origin browser access is disabled.
PDG_CORS_ORIGINS=
