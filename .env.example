# Generate a strong value with: openssl rand -hex 32
PDG_API_KEY=replace-with-at-least-24-random-characters
# Comma-separated current and previous Bearer tokens enable zero-downtime rotation.
PDG_MCP_AUTH_TOKENS=replace-with-a-different-24-character-token
# Production Compose uses this instead: /run/secrets/mcp_auth_token
# PDG_MCP_AUTH_TOKEN_FILE=/run/secrets/mcp_auth_token

PDG_PORT=8000
PDG_HOST=0.0.0.0
PDG_ENVIRONMENT=production
PDG_DATA_DIR=/data
PDG_DOCUMENTS_DIR=/data/documents
PDG_INBOX_DIR=/inbox
PDG_CACHE_DIR=/data/cache
PDG_BACKUP_DIR=/backups
PDG_DATABASE_URL=sqlite:////data/database/gateway.db
PDG_MAX_FILE_SIZE_MB=25
PDG_MAX_REQUEST_BODY_MB=27
PDG_MAX_ARCHIVE_UNCOMPRESSED_MB=250
PDG_UPLOAD_BUFFER_BYTES=1048576
PDG_MIN_FREE_DISK_MB=100
PDG_CHUNK_SIZE_TOKENS=500
PDG_CHUNK_OVERLAP_TOKENS=50
PDG_MIN_CHUNK_TOKENS=40
PDG_DEFAULT_PAGE_SIZE=20
PDG_MAX_PAGE_SIZE=100
PDG_DEFAULT_SEARCH_TOP_K=5
PDG_MAX_SEARCH_TOP_K=20
PDG_DEFAULT_RESPONSE_MAX_CHARS=8000
PDG_MAX_RESPONSE_CHARS=24000
PDG_DEFAULT_RESPONSE_MAX_TOKENS=2000
PDG_MAX_RESPONSE_TOKENS=6000
PDG_MAX_NEIGHBOR_WINDOW=1
PDG_RATE_LIMIT_REQUESTS=120
PDG_RATE_LIMIT_WINDOW_SECONDS=60
PDG_LOG_LEVEL=INFO
PDG_MAX_CONCURRENT_CONVERSIONS=1
PDG_CONVERSION_TIMEOUT_SECONDS=120
PDG_CONVERSION_QUEUE_TIMEOUT_SECONDS=5
PDG_SEARCH_TIMEOUT_SECONDS=10

# Optional, entirely local semantic/hybrid retrieval. The base image stays lexical-only.
PDG_SEMANTIC_ENABLED=false
PDG_SEMANTIC_FALLBACK_ENABLED=true
PDG_DEFAULT_RETRIEVAL_MODE=lexical
PDG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
PDG_EMBEDDING_MODEL_VERSION=fastembed-0.8.0-onnx-q
PDG_EMBEDDING_DIMENSION=384
PDG_EMBEDDING_QUERY_PREFIX=
PDG_EMBEDDING_PASSAGE_PREFIX=
PDG_EMBEDDING_CACHE_DIR=/models
PDG_EMBEDDING_OFFLINE=true
PDG_EMBEDDING_BATCH_SIZE=32
PDG_EMBEDDING_THREADS=2
PDG_MAX_CONCURRENT_EMBEDDINGS=1
PDG_EMBEDDING_TIMEOUT_SECONDS=180
PDG_EMBEDDING_QUEUE_TIMEOUT_SECONDS=5
PDG_VECTOR_STORE_URL=http://qdrant:6333
PDG_VECTOR_COLLECTION=pdg_chunks_v1
PDG_VECTOR_STORE_TIMEOUT_SECONDS=10
PDG_SEMANTIC_MIN_SCORE=0.25
PDG_HYBRID_RRF_K=60
PDG_MAX_RESULTS_PER_DOCUMENT=3
PDG_SEMANTIC_MEMORY_LIMIT=3g
PDG_VECTOR_MEMORY_LIMIT=1g
# Required only for public HTTPS deployments.
PDG_PUBLIC_BASE_URL=

# Production host paths. Create these with owner 10001:10001 before Compose starts.
PDG_DOCUMENTS_HOST_PATH=./state/documents
PDG_INBOX_HOST_PATH=./documents
PDG_CACHE_HOST_PATH=./state/cache
PDG_DATABASE_HOST_PATH=./state/database
PDG_BACKUP_HOST_PATH=./backups
PDG_MCP_AUTH_TOKEN_HOST_FILE=./secrets/mcp_auth_token
PDG_BIND_PORT=8000
PDG_CPU_LIMIT=2.0
PDG_MEMORY_LIMIT=2g
PDG_LOG_MAX_SIZE=10m
PDG_LOG_MAX_FILES=5
PDG_IMAGE_TAG=0.1.0

# Public HTTPS profile only. Leave empty for the recommended Tailscale setup.
PDG_PUBLIC_DOMAIN=
CADDY_EMAIL=
PDG_PROXY_MAX_BODY_SIZE=27MB

# Comma-separated, exact MCP Host-header patterns. Add your DNS name or Tailscale IP.
PDG_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*

# Empty means cross-origin browser access is disabled.
PDG_CORS_ORIGINS=
