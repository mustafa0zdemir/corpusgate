# Generate a strong value with: openssl rand -hex 32
CORPUSGATE_API_KEY=replace-with-at-least-24-random-characters
# Comma-separated current and previous Bearer tokens enable zero-downtime rotation.
CORPUSGATE_MCP_AUTH_TOKENS=replace-with-a-different-24-character-token
# Production Compose uses this instead: /run/secrets/mcp_auth_token
# CORPUSGATE_MCP_AUTH_TOKEN_FILE=/run/secrets/mcp_auth_token

CORPUSGATE_PORT=8000
CORPUSGATE_HOST=0.0.0.0
CORPUSGATE_ENVIRONMENT=production
CORPUSGATE_DATA_DIR=/data
CORPUSGATE_DOCUMENTS_DIR=/data/documents
CORPUSGATE_INBOX_DIR=/inbox
CORPUSGATE_CACHE_DIR=/data/cache
CORPUSGATE_BACKUP_DIR=/backups
CORPUSGATE_DATABASE_URL=sqlite:////data/database/gateway.db
CORPUSGATE_MAX_FILE_SIZE_MB=25
CORPUSGATE_MAX_REQUEST_BODY_MB=27
CORPUSGATE_MAX_ARCHIVE_UNCOMPRESSED_MB=250
CORPUSGATE_UPLOAD_BUFFER_BYTES=1048576
CORPUSGATE_MIN_FREE_DISK_MB=100
CORPUSGATE_CHUNK_SIZE_TOKENS=500
CORPUSGATE_CHUNK_OVERLAP_TOKENS=50
CORPUSGATE_MIN_CHUNK_TOKENS=40
CORPUSGATE_DEFAULT_PAGE_SIZE=20
CORPUSGATE_MAX_PAGE_SIZE=100
CORPUSGATE_DEFAULT_SEARCH_TOP_K=5
CORPUSGATE_MAX_SEARCH_TOP_K=20
CORPUSGATE_DEFAULT_RESPONSE_MAX_CHARS=8000
CORPUSGATE_MAX_RESPONSE_CHARS=24000
CORPUSGATE_DEFAULT_RESPONSE_MAX_TOKENS=2000
CORPUSGATE_MAX_RESPONSE_TOKENS=6000
CORPUSGATE_MAX_NEIGHBOR_WINDOW=1
CORPUSGATE_RATE_LIMIT_REQUESTS=120
CORPUSGATE_RATE_LIMIT_WINDOW_SECONDS=60
CORPUSGATE_LOG_LEVEL=INFO
CORPUSGATE_MAX_CONCURRENT_CONVERSIONS=1
CORPUSGATE_CONVERSION_TIMEOUT_SECONDS=120
CORPUSGATE_CONVERSION_QUEUE_TIMEOUT_SECONDS=5
CORPUSGATE_SEARCH_TIMEOUT_SECONDS=10

# Optional, entirely local semantic/hybrid retrieval. The base image stays lexical-only.
CORPUSGATE_SEMANTIC_ENABLED=false
CORPUSGATE_SEMANTIC_FALLBACK_ENABLED=true
CORPUSGATE_DEFAULT_RETRIEVAL_MODE=lexical
CORPUSGATE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CORPUSGATE_EMBEDDING_MODEL_VERSION=fastembed-0.8.0-onnx-q
CORPUSGATE_EMBEDDING_DIMENSION=384
CORPUSGATE_EMBEDDING_QUERY_PREFIX=
CORPUSGATE_EMBEDDING_PASSAGE_PREFIX=
CORPUSGATE_EMBEDDING_CACHE_DIR=/models
CORPUSGATE_EMBEDDING_OFFLINE=true
CORPUSGATE_EMBEDDING_BATCH_SIZE=32
CORPUSGATE_EMBEDDING_THREADS=2
CORPUSGATE_MAX_CONCURRENT_EMBEDDINGS=1
CORPUSGATE_EMBEDDING_TIMEOUT_SECONDS=180
CORPUSGATE_EMBEDDING_QUEUE_TIMEOUT_SECONDS=5
CORPUSGATE_VECTOR_STORE_URL=http://qdrant:6333
CORPUSGATE_VECTOR_COLLECTION=corpusgate_chunks_v1
CORPUSGATE_VECTOR_STORE_TIMEOUT_SECONDS=10
CORPUSGATE_SEMANTIC_MIN_SCORE=0.25
CORPUSGATE_HYBRID_RRF_K=60
CORPUSGATE_MAX_RESULTS_PER_DOCUMENT=3
CORPUSGATE_SEMANTIC_MEMORY_LIMIT=3g
CORPUSGATE_VECTOR_MEMORY_LIMIT=1g
# Required only for public HTTPS deployments.
CORPUSGATE_PUBLIC_BASE_URL=

# Production host paths. Create these with owner 10001:10001 before Compose starts.
CORPUSGATE_DOCUMENTS_HOST_PATH=./state/documents
CORPUSGATE_INBOX_HOST_PATH=./documents
CORPUSGATE_CACHE_HOST_PATH=./state/cache
CORPUSGATE_DATABASE_HOST_PATH=./state/database
CORPUSGATE_BACKUP_HOST_PATH=./backups
CORPUSGATE_MCP_AUTH_TOKEN_HOST_FILE=./secrets/mcp_auth_token
CORPUSGATE_BIND_PORT=8000
CORPUSGATE_CPU_LIMIT=2.0
CORPUSGATE_MEMORY_LIMIT=2g
CORPUSGATE_LOG_MAX_SIZE=10m
CORPUSGATE_LOG_MAX_FILES=5
CORPUSGATE_IMAGE_TAG=0.1.0

# Public HTTPS profile only. Leave empty for the recommended Tailscale setup.
CORPUSGATE_PUBLIC_DOMAIN=
CADDY_EMAIL=
CORPUSGATE_PROXY_MAX_BODY_SIZE=27MB

# Comma-separated, exact MCP Host-header patterns. Add your DNS name or Tailscale IP.
CORPUSGATE_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*

# Empty means cross-origin browser access is disabled.
CORPUSGATE_CORS_ORIGINS=
